{
  "name": "@synodlang/player",
  "version": "0.2.1",
  "description": "Plays a Synod scene.json on a canvas.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/synod-player.d.ts",
      "import": "./dist/synod-player.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "biome ci .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "sync-scenes": "node scripts/sync-scenes.ts",
    "bench": "node --expose-gc test/bench/bench.ts",
    "golden:update": "node scripts/update-goldens.ts",
    "build": "node scripts/build.ts",
    "demo": "node scripts/build.ts && node scripts/serve.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:pixel": "playwright test",
    "test:pixel:docker": "node scripts/check-playwright-image.ts --docker"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
